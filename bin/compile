#!/usr/bin/env bash
indent() {
    sed -u 's/^/      /'
}

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"

if [ ! -f "${ENV_DIR}/APP_BASE" ]; then
    echo "APP_BASE was not set. Aborting" | indent
    exit 1
fi
APP_BASE="$(cat "${ENV_DIR}/APP_BASE")"

# Resolve symlinks in app dir by replacing them with their targets
# This allows using symlinks locally (e.g., engines -> ../../engines) while
# the real content is copied into place on Heroku
for item in "${BUILD_DIR}/${APP_BASE}/"*; do
    if [ -L "$item" ]; then
        name=$(basename "$item")
        target=$(readlink -f "$item")
        if [ -e "$target" ]; then
            echo "Resolving symlink '$name'" | indent
            rm "$item"
            cp -r "$target" "$item"
        fi
    fi
done

(
    cp -r "${BUILD_DIR}/${APP_BASE}/." "${BUILD_DIR}"
)

if [ $? -ne 0 ]; then
    echo "FAILED to copy directory into place" | indent
    exit 1
fi

echo "Copied ${APP_BASE} to root of app successfully" | indent

ls "${BUILD_DIR}"
