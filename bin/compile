#!/usr/bin/env bash

# Ensure wildcards in globs match dotfiles too.
shopt -s dotglob

indent() {
    sed -u 's/^/      /'
}

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"
STAGE="$(mktemp -d)"

if [ ! -f "${ENV_DIR}/APP_BASE" ]; then
    echo "APP_BASE was not set. Aborting" | indent
    exit 1
fi
APP_BASE="$(cat "${ENV_DIR}/APP_BASE")"

# Resolve symlinks in app dir by replacing them with their targets
# This allows using symlinks locally (e.g., engines -> ../../engines) while
# the real content is moved into place on Heroku
for item in "${BUILD_DIR}/${APP_BASE}/"*; do
    if [ -L "$item" ]; then
        name=$(basename "$item")
        target=$(readlink -f "$item")
        if [ -e "$target" ]; then
            echo "Resolving symlink '$name'" | indent
            rm "$item"
            mv "$target" "$item"
        fi
    fi
done

(
    mv "${BUILD_DIR}/${APP_BASE}" "${STAGE}" &&
    rm -rf "${BUILD_DIR}"/* &&
    mv "${STAGE}/$(basename "$APP_BASE")"/* "${BUILD_DIR}"
)

if [ $? -ne 0 ]; then
    echo "FAILED to move directory into place" | indent
    exit 1
fi

echo "Moved ${APP_BASE} to root of app successfully" | indent
